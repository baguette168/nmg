<Window x:Class="NMG.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NMG — .NET Memory-shell Generator" Height="720" Width="920"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource Brush.WindowBg}"
        FontFamily="Microsoft YaHei UI" FontSize="14">

    <Window.Resources>
        <!-- Label -->
        <Style x:Key="L" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <!-- Hint -->
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextHint}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <!-- ComboBoxItem -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{DynamicResource Brush.InputBg}"
                                CornerRadius="3" Margin="2,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.ItemHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.ItemSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ComboBox ToggleButton -->
        <ControlTemplate x:Key="CmbToggle" TargetType="ToggleButton">
            <Grid>
                <Border x:Name="Bd" CornerRadius="4" Background="{DynamicResource Brush.InputBg}"
                        BorderBrush="{DynamicResource Brush.InputBorder}" BorderThickness="1"/>
                <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 8 0 Z"
                      Fill="{DynamicResource Brush.Arrow}"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.HoverBorder}"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource Brush.Text}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <!-- ComboBox -->
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource CmbToggle}" Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              Margin="12,8,36,8"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource Brush.PopupBg}"
                                        BorderBrush="{DynamicResource Brush.PopupBorder}"
                                        BorderThickness="1" CornerRadius="4"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220"
                                        Margin="0,2,0,0">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- TextBox (for password/seed only) -->
        <Style x:Key="DarkTB" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Brush.InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Brush.InputBorder}"
                                BorderThickness="1" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.FocusBorder}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.HoverBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Primary Button -->
        <Style x:Key="B1" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.BtnPrimaryBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.BtnPrimaryFg}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Secondary Button -->
        <Style x:Key="B2" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.BtnSecondaryBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.BtnSecondaryFg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Lang Button -->
        <Style x:Key="BL" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.BtnSecondaryBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.TitleBarBg}"
                BorderBrush="{DynamicResource Brush.InputBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="NMG" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Text}" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtSub" Text=" — .NET Memory-shell Generator"
                               FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="BtnLang" Content="EN" Click="BtnLang_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource BL}"/>
            </Grid>
        </Border>

        <!-- Main -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,28">

                <!-- Form -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="280"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*" MinWidth="280"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                        <TextBlock x:Name="LblType" Text="内存马类型" Style="{StaticResource L}"/>
                        <ComboBox x:Name="CmbType" Style="{StaticResource DarkCombo}" SelectionChanged="CmbType_Changed">
                            <ComboBoxItem Content="VPP — VirtualPathProvider" IsSelected="True" Tag="vpp"/>
                            <ComboBoxItem Content="Route — RouteBase (MVC)" Tag="route"/>
                            <ComboBoxItem Content="HttpListener — Standalone" Tag="httplistener"/>
                        </ComboBox>
                        <TextBlock x:Name="HintType" Text="ASP.NET 管道中的注入点" Style="{StaticResource H}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16">
                        <TextBlock x:Name="LblShell" Text="协议" Style="{StaticResource L}"/>
                        <ComboBox x:Name="CmbShell" Style="{StaticResource DarkCombo}">
                            <ComboBoxItem Content="Godzilla 4.x — AES-128" IsSelected="True" Tag="godzilla"/>
                            <ComboBoxItem Content="Behinder 4.x — AES-128" Tag="behinder"/>
                            <ComboBoxItem Content="AntSword — Base64" Tag="antsword"/>
                        </ComboBox>
                        <TextBlock x:Name="HintShell" Text="Webshell 管理工具通信协议" Style="{StaticResource H}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                        <TextBlock x:Name="LblPass" Text="连接密码" Style="{StaticResource L}"/>
                        <TextBox x:Name="TxtPass" Style="{StaticResource DarkTB}" Text="p@ssw0rd"/>
                        <TextBlock x:Name="HintPass" Text="Webshell 客户端认证用" Style="{StaticResource H}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16">
                        <TextBlock x:Name="LblTarget" Text="目标框架" Style="{StaticResource L}"/>
                        <ComboBox x:Name="CmbTarget" Style="{StaticResource DarkCombo}">
                            <ComboBoxItem Content=".NET Framework 4.0" IsSelected="True" Tag="net40"/>
                            <ComboBoxItem Content=".NET Framework 4.7.2" Tag="net472"/>
                        </ComboBox>
                        <TextBlock x:Name="HintTarget" Text="Payload 编译目标" Style="{StaticResource H}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,16">
                        <TextBlock x:Name="LblFormat" Text="输出格式" Style="{StaticResource L}"/>
                        <ComboBox x:Name="CmbFormat" Style="{StaticResource DarkCombo}">
                            <ComboBoxItem Content="ASPX Injector Page" IsSelected="True" Tag="aspx"/>
                            <ComboBoxItem Content="Raw Base64" Tag="b64"/>
                        </ComboBox>
                        <TextBlock x:Name="HintFormat" Text="Payload 投递方式" Style="{StaticResource H}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,16">
                        <TextBlock x:Name="LblSeed" Text="随机种子" Style="{StaticResource L}"/>
                        <TextBox x:Name="TxtSeed" Style="{StaticResource DarkTB}"/>
                        <TextBlock x:Name="HintSeed" Text="固定种子 = 确定性输出" Style="{StaticResource H}"/>
                    </StackPanel>
                </Grid>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,20">
                    <Button x:Name="BtnGenerate" Content="生成 Payload" Style="{StaticResource B2}"
                            Click="BtnGenerate_Click" Margin="0,0,10,0"/>
                    <Button x:Name="BtnCopy" Content="复制" Style="{StaticResource B2}"
                            Click="BtnCopy_Click" Margin="0,0,10,0"/>
                    <Button x:Name="BtnSave" Content="另存为..." Style="{StaticResource B2}"
                            Click="BtnSave_Click"/>
                </StackPanel>

                <!-- Status -->
                <TextBlock x:Name="TxtStatus" Text="配置参数后点击生成" FontSize="13"
                           Foreground="{DynamicResource Brush.StatusInfo}" Margin="0,0,0,10"/>

                <!-- Output: TextBlock in ScrollViewer (NO white background) -->
                <Border Background="{DynamicResource Brush.PanelBg}"
                        BorderBrush="{DynamicResource Brush.InputBorder}" BorderThickness="1"
                        CornerRadius="4" Padding="14" MinHeight="200">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="170"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtOutput" Text=""
                                       Foreground="{DynamicResource Brush.TextOutput}"
                                       FontFamily="Consolas" FontSize="12"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                        <TextBlock Grid.Row="1" x:Name="TxtMeta" Text=""
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   FontSize="12" Margin="0,10,0,0" FontFamily="Consolas"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
