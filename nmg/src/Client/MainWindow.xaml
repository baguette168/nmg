<Window x:Class="NMG.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NMG — .NET Memory-shell Generator" Height="640" Width="860"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#0E0E0E" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FAFAFA"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#616161"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="ComboInput" TargetType="ComboBox">
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="Textinput" TargetType="TextBox">
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#FAFAFA"/>
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Foreground" Value="#0E0E0E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="NMG" FontSize="22" FontWeight="Bold" Foreground="#FAFAFA"/>
            <TextBlock Text=".NET Memory-shell Generator" FontSize="12" Foreground="#616161"/>
        </StackPanel>

        <!-- Form -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Row 0 -->
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                <TextBlock Text="MEMORY SHELL TYPE" Style="{StaticResource Label}"/>
                <ComboBox x:Name="CmbType" Style="{StaticResource ComboInput}" SelectionChanged="CmbType_Changed">
                    <ComboBoxItem Content="VPP — VirtualPathProvider" IsSelected="True" Tag="vpp"/>
                    <ComboBoxItem Content="Route — RouteBase (MVC)" Tag="route"/>
                    <ComboBoxItem Content="HttpListener — Standalone" Tag="httplistener"/>
                </ComboBox>
                <TextBlock Text="Target injection point in the ASP.NET pipeline" Style="{StaticResource Hint}"/>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                <TextBlock Text="SHELL PROTOCOL" Style="{StaticResource Label}"/>
                <ComboBox x:Name="CmbShell" Style="{StaticResource ComboInput}">
                    <ComboBoxItem Content="Godzilla 4.x — AES-128" IsSelected="True" Tag="godzilla"/>
                    <ComboBoxItem Content="Behinder 4.x — AES-128" Tag="behinder"/>
                    <ComboBoxItem Content="AntSword — Base64" Tag="antsword"/>
                </ComboBox>
                <TextBlock Text="Webshell manager communication protocol" Style="{StaticResource Hint}"/>
            </StackPanel>

            <!-- Row 1 -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                <TextBlock Text="CONNECTION PASSWORD" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtPass" Style="{StaticResource Textinput}" Text="p@ssw0rd"/>
                <TextBlock Text="Used by the webshell client to authenticate" Style="{StaticResource Hint}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                <TextBlock Text="TARGET FRAMEWORK" Style="{StaticResource Label}"/>
                <ComboBox x:Name="CmbTarget" Style="{StaticResource ComboInput}">
                    <ComboBoxItem Content=".NET Framework 4.0" IsSelected="True" Tag="net40"/>
                    <ComboBoxItem Content=".NET Framework 4.7.2" Tag="net472"/>
                </ComboBox>
                <TextBlock Text="Payload compilation target" Style="{StaticResource Hint}"/>
            </StackPanel>

            <!-- Row 2 -->
            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                <TextBlock Text="OUTPUT FORMAT" Style="{StaticResource Label}"/>
                <ComboBox x:Name="CmbFormat" Style="{StaticResource ComboInput}">
                    <ComboBoxItem Content="ASPX Injector Page" IsSelected="True" Tag="aspx"/>
                    <ComboBoxItem Content="Raw Base64" Tag="b64"/>
                </ComboBox>
                <TextBlock Text="How the payload is delivered" Style="{StaticResource Hint}"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                <TextBlock Text="RANDOMIZATION SEED" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtSeed" Style="{StaticResource Textinput}" Text=""/>
                <TextBlock Text="Fixed seed = deterministic output" Style="{StaticResource Hint}"/>
            </StackPanel>
        </Grid>

        <!-- Generate Button -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Generate Payload" Style="{StaticResource BtnPrimary}" Click="BtnGenerate_Click" Margin="0,0,8,0" x:Name="BtnGenerate"/>
            <Button Content="Copy" Style="{StaticResource BtnSecondary}" Click="BtnCopy_Click" Margin="0,0,8,0"/>
            <Button Content="Save As..." Style="{StaticResource BtnSecondary}" Click="BtnSave_Click"/>
        </StackPanel>

        <!-- Output -->
        <Border Grid.Row="3" Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1"
                CornerRadius="6" Padding="12" MinHeight="200">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="TxtStatus" Text="Configure parameters and click Generate" 
                           Foreground="#616161" FontSize="11" Margin="0,0,0,8"/>
                <TextBox Grid.Row="1" x:Name="TxtOutput" Background="Transparent" BorderThickness="0"
                         Foreground="#9E9E9E" FontFamily="Consolas" FontSize="11"
                         TextWrapping="Wrap" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                <TextBlock Grid.Row="2" x:Name="TxtMeta" Text="" Foreground="#616161" FontSize="11" Margin="0,8,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
