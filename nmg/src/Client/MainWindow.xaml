<Window x:Class="NMG.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NMG — .NET Memory-shell Generator" Height="720" Width="920"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#0E0E0E"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14">

    <Window.Resources>
        <!-- ═══ 全局文字：高亮白 ═══ -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>

        <!-- ═══ 标签：白色 加粗 600 ═══ -->
        <Style x:Key="L" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- ═══ 辅助说明：中灰 不可太暗 ═══ -->
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <!-- ═══ ComboBox：深底白字 ═══ -->
        <Style x:Key="CB" TargetType="ComboBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <!-- ═══ ComboBoxItem：深底白字 悬停高亮 ═══ -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#333333"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3A3A3A"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ TextBox：深底白字 高对比 ═══ -->
        <Style x:Key="TB" TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FFFFFF"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ 主按钮：白底黑字 ═══ -->
        <Style x:Key="B1" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0E0E0E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D0D0D0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B0B0B0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ 次按钮：深底白字加粗 ═══ -->
        <Style x:Key="B2" TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444444"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2A2A2A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ 语言切换按钮 ═══ -->
        <Style x:Key="BL" TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444444"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ ComboBoxItem 下拉覆盖 ═══ -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ 标题栏 ═══ -->
        <Border Grid.Row="0" Background="#141414" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="NMG" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtSub" Text=" — .NET Memory-shell Generator"
                               FontSize="14" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="BtnLang" Content="EN" Click="BtnLang_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource BL}"/>
            </Grid>
        </Border>

        <!-- ═══ 主内容 ═══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,28">

                <!-- ═══ 表单 ═══ -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 0 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,18">
                        <TextBlock x:Name="LblType" Text="内存马类型" Style="{StaticResource L}"/>
                        <ComboBox x:Name="CmbType" Style="{StaticResource CB}" SelectionChanged="CmbType_Changed">
                            <ComboBoxItem Content="VPP — VirtualPathProvider" IsSelected="True" Tag="vpp"/>
                            <ComboBoxItem Content="Route — RouteBase (MVC)" Tag="route"/>
                            <ComboBoxItem Content="HttpListener — Standalone" Tag="httplistener"/>
                        </ComboBox>
                        <TextBlock x:Name="HintType" Text="ASP.NET 管道中的注入点" Style="{StaticResource H}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,18">
                        <TextBlock x:Name="LblShell" Text="协议" Style="{StaticResource L}"/>
                        <ComboBox x:Name="CmbShell" Style="{StaticResource CB}">
                            <ComboBoxItem Content="Godzilla 4.x — AES-128" IsSelected="True" Tag="godzilla"/>
                            <ComboBoxItem Content="Behinder 4.x — AES-128" Tag="behinder"/>
                            <ComboBoxItem Content="AntSword — Base64" Tag="antsword"/>
                        </ComboBox>
                        <TextBlock x:Name="HintShell" Text="Webshell 管理工具通信协议" Style="{StaticResource H}"/>
                    </StackPanel>

                    <!-- Row 1 -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,18">
                        <TextBlock x:Name="LblPass" Text="连接密码" Style="{StaticResource L}"/>
                        <TextBox x:Name="TxtPass" Style="{StaticResource TB}" Text="p@ssw0rd"/>
                        <TextBlock x:Name="HintPass" Text="Webshell 客户端认证用" Style="{StaticResource H}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,18">
                        <TextBlock x:Name="LblTarget" Text="目标框架" Style="{StaticResource L}"/>
                        <ComboBox x:Name="CmbTarget" Style="{StaticResource CB}">
                            <ComboBoxItem Content=".NET Framework 4.0" IsSelected="True" Tag="net40"/>
                            <ComboBoxItem Content=".NET Framework 4.7.2" Tag="net472"/>
                        </ComboBox>
                        <TextBlock x:Name="HintTarget" Text="Payload 编译目标" Style="{StaticResource H}"/>
                    </StackPanel>

                    <!-- Row 2 -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,18">
                        <TextBlock x:Name="LblFormat" Text="输出格式" Style="{StaticResource L}"/>
                        <ComboBox x:Name="CmbFormat" Style="{StaticResource CB}">
                            <ComboBoxItem Content="ASPX Injector Page" IsSelected="True" Tag="aspx"/>
                            <ComboBoxItem Content="Raw Base64" Tag="b64"/>
                        </ComboBox>
                        <TextBlock x:Name="HintFormat" Text="Payload 投递方式" Style="{StaticResource H}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,18">
                        <TextBlock x:Name="LblSeed" Text="随机种子" Style="{StaticResource L}"/>
                        <TextBox x:Name="TxtSeed" Style="{StaticResource TB}"/>
                        <TextBlock x:Name="HintSeed" Text="固定种子 = 确定性输出" Style="{StaticResource H}"/>
                    </StackPanel>
                </Grid>

                <!-- ═══ 按钮行 ═══ -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,20">
                    <Button x:Name="BtnGenerate" Content="生成 Payload" Style="{StaticResource B1}"
                            Click="BtnGenerate_Click" Margin="0,0,10,0"/>
                    <Button x:Name="BtnCopy" Content="复制" Style="{StaticResource B2}"
                            Click="BtnCopy_Click" Margin="0,0,10,0"/>
                    <Button x:Name="BtnSave" Content="另存为..." Style="{StaticResource B2}"
                            Click="BtnSave_Click"/>
                </StackPanel>

                <!-- ═══ 状态 ═══ -->
                <TextBlock x:Name="TxtStatus" Text="配置参数后点击生成" FontSize="13"
                           Foreground="#A0A0A0" Margin="0,0,0,10"/>

                <!-- ═══ 输出区域 ═══ -->
                <Border Background="#141414" BorderBrush="#3A3A3A" BorderThickness="1"
                        CornerRadius="6" Padding="14" MinHeight="200">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox Grid.Row="0" x:Name="TxtOutput"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#D0D0D0" FontFamily="Consolas" FontSize="12"
                                 CaretBrush="#FFFFFF" TextWrapping="Wrap" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        <TextBlock Grid.Row="1" x:Name="TxtMeta" Text=""
                                   Foreground="#A0A0A0" FontSize="12" Margin="0,10,0,0"
                                   FontFamily="Consolas"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
