<Window x:Class="NMG.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="NMG — .NET Memory-shell Generator" Height="720" Width="920"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="14"
>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar with wpfui -->
        <ui:TitleBar Grid.Row="0" Title="NMG — .NET Memory-shell Generator">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                    <TextBlock Text="NMG" FontWeight="Bold" FontSize="15" Margin="0,0,4,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <Button x:Name="BtnLang" Content="EN" Click="BtnLang_Click"
                            FontSize="11" Padding="8,3" Margin="16,0,0,0"/>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Main content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="28,16,28,28">
            <StackPanel>

                <!-- Form: 3 rows × 2 cols -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="280"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*" MinWidth="280"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 0 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                        <TextBlock x:Name="LblType" Text="内存马类型" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbType" SelectionChanged="CmbType_Changed">
                            <ComboBoxItem Content="VPP — VirtualPathProvider" IsSelected="True" Tag="vpp"/>
                            <ComboBoxItem Content="Route — RouteBase (MVC)" Tag="route"/>
                            <ComboBoxItem Content="HttpListener — Standalone" Tag="httplistener"/>
                        </ComboBox>
                        <TextBlock x:Name="HintType" Text="ASP.NET 管道中的注入点" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16">
                        <TextBlock x:Name="LblShell" Text="协议" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbShell">
                            <ComboBoxItem Content="Godzilla 4.x — AES-128" IsSelected="True" Tag="godzilla"/>
                            <ComboBoxItem Content="Behinder 4.x — AES-128" Tag="behinder"/>
                            <ComboBoxItem Content="AntSword — Base64" Tag="antsword"/>
                        </ComboBox>
                        <TextBlock x:Name="HintShell" Text="Webshell 管理工具通信协议" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Row 1 -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                        <TextBlock x:Name="LblPass" Text="连接密码" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtPass" Text="p@ssw0rd"/>
                        <TextBlock x:Name="HintPass" Text="Webshell 客户端认证用" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16">
                        <TextBlock x:Name="LblTarget" Text="目标框架" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbTarget">
                            <ComboBoxItem Content=".NET Framework 4.0" IsSelected="True" Tag="net40"/>
                            <ComboBoxItem Content=".NET Framework 4.7.2" Tag="net472"/>
                        </ComboBox>
                        <TextBlock x:Name="HintTarget" Text="Payload 编译目标" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Row 2 -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,16">
                        <TextBlock x:Name="LblFormat" Text="输出格式" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbFormat">
                            <ComboBoxItem Content="ASPX Injector Page" IsSelected="True" Tag="aspx"/>
                            <ComboBoxItem Content="Raw Base64" Tag="b64"/>
                        </ComboBox>
                        <TextBlock x:Name="HintFormat" Text="Payload 投递方式" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,16">
                        <TextBlock x:Name="LblSeed" Text="随机种子" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtSeed"/>
                        <TextBlock x:Name="HintSeed" Text="固定种子 = 确定性输出" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,20">
                    <Button x:Name="BtnGenerate" Content="生成 Payload" Click="BtnGenerate_Click"
                            Margin="0,0,10,0" Padding="24,10" FontWeight="Bold"/>
                    <Button x:Name="BtnCopy" Content="复制" Click="BtnCopy_Click"
                            Margin="0,0,10,0" Padding="18,10"/>
                    <Button x:Name="BtnSave" Content="另存为..." Click="BtnSave_Click"
                            Padding="18,10"/>
                </StackPanel>

                <!-- Status -->
                <TextBlock x:Name="TxtStatus" Text="配置参数后点击生成" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"/>

                <!-- Output -->
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="14" MinHeight="200">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="170"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtOutput" Text=""
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontFamily="Consolas" FontSize="12"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                        <TextBlock Grid.Row="1" x:Name="TxtMeta" Text=""
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   FontSize="12" Margin="0,10,0,0" FontFamily="Consolas"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
