<Window x:Class="NMG.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NMG — .NET Memory-shell Generator" Height="680" Width="900"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#0E0E0E">
    <Window.Resources>
        <!-- Base text -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FAFAFA"/>
        </Style>
        <!-- Section labels -->
        <Style x:Key="L" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <!-- Hints -->
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <!-- ComboBox -->
        <Style x:Key="CB" TargetType="ComboBox">
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <!-- TextBox -->
        <Style x:Key="TB" TargetType="TextBox">
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#FAFAFA"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- Primary button -->
        <Style x:Key="B1" TargetType="Button">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Foreground" Value="#0E0E0E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="22,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Secondary button -->
        <Style x:Key="B2" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
            <!-- ComboBoxItem dark theme -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#2A2A2A"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#333333"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- ToolTip dark theme -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
        </Style>
        <!-- ContextMenu dark theme -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
        </Style>
</Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="#141414" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="NMG" FontSize="15" FontWeight="Bold" Foreground="#FAFAFA" Margin="0,0,4,0"/>
                    <TextBlock x:Name="TxtSub" Text=" — .NET Memory-shell Generator" FontSize="13" Foreground="#616161" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="BtnLang" Content="EN" Click="BtnLang_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#2A2A2A" Foreground="#FAFAFA" BorderThickness="0"
                        Padding="10,4" FontSize="11" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Main content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,24">
                <!-- Form grid -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 0: Type + Protocol -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock x:Name="LblType" Text="内存马类型" Style="{StaticResource L}"/>
                        <ComboBox x:Name="CmbType" Style="{StaticResource CB}" SelectionChanged="CmbType_Changed">
                            <ComboBoxItem Content="VPP — VirtualPathProvider" IsSelected="True" Tag="vpp"/>
                            <ComboBoxItem Content="Route — RouteBase (MVC)" Tag="route"/>
                            <ComboBoxItem Content="HttpListener — Standalone" Tag="httplistener"/>
                        </ComboBox>
                        <TextBlock x:Name="HintType" Text="ASP.NET 管道中的注入点" Style="{StaticResource H}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                        <TextBlock x:Name="LblShell" Text="协议" Style="{StaticResource L}"/>
                        <ComboBox x:Name="CmbShell" Style="{StaticResource CB}">
                            <ComboBoxItem Content="Godzilla 4.x — AES-128" IsSelected="True" Tag="godzilla"/>
                            <ComboBoxItem Content="Behinder 4.x — AES-128" Tag="behinder"/>
                            <ComboBoxItem Content="AntSword — Base64" Tag="antsword"/>
                        </ComboBox>
                        <TextBlock x:Name="HintShell" Text="Webshell 管理工具通信协议" Style="{StaticResource H}"/>
                    </StackPanel>

                    <!-- Row 1: Password + Target -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock x:Name="LblPass" Text="连接密码" Style="{StaticResource L}"/>
                        <TextBox x:Name="TxtPass" Style="{StaticResource TB}" Text="p@ssw0rd"/>
                        <TextBlock x:Name="HintPass" Text="Webshell 客户端认证用" Style="{StaticResource H}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                        <TextBlock x:Name="LblTarget" Text="目标框架" Style="{StaticResource L}"/>
                        <ComboBox x:Name="CmbTarget" Style="{StaticResource CB}">
                            <ComboBoxItem Content=".NET Framework 4.0" IsSelected="True" Tag="net40"/>
                            <ComboBoxItem Content=".NET Framework 4.7.2" Tag="net472"/>
                        </ComboBox>
                        <TextBlock x:Name="HintTarget" Text="Payload 编译目标" Style="{StaticResource H}"/>
                    </StackPanel>

                    <!-- Row 2: Format + Seed -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock x:Name="LblFormat" Text="输出格式" Style="{StaticResource L}"/>
                        <ComboBox x:Name="CmbFormat" Style="{StaticResource CB}">
                            <ComboBoxItem Content="ASPX Injector Page" IsSelected="True" Tag="aspx"/>
                            <ComboBoxItem Content="Raw Base64" Tag="b64"/>
                        </ComboBox>
                        <TextBlock x:Name="HintFormat" Text="Payload 投递方式" Style="{StaticResource H}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14">
                        <TextBlock x:Name="LblSeed" Text="随机种子" Style="{StaticResource L}"/>
                        <TextBox x:Name="TxtSeed" Style="{StaticResource TB}"/>
                        <TextBlock x:Name="HintSeed" Text="固定种子 = 确定性输出" Style="{StaticResource H}"/>
                    </StackPanel>
                </Grid>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button x:Name="BtnGenerate" Content="生成 Payload" Style="{StaticResource B1}"
                            Click="BtnGenerate_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnCopy" Content="复制" Style="{StaticResource B2}"
                            Click="BtnCopy_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnSave" Content="另存为..." Style="{StaticResource B2}"
                            Click="BtnSave_Click" Margin="0,0,8,0"/>
                </StackPanel>

                <!-- Status -->
                <TextBlock x:Name="TxtStatus" Text="配置参数后点击生成" FontSize="11"
                           Foreground="#555555" Margin="0,0,0,8"/>

                <!-- Output -->
                <Border Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1"
                        CornerRadius="6" Padding="12" MinHeight="180">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox Grid.Row="0" x:Name="TxtOutput" Background="Transparent" BorderThickness="0"
                                 Foreground="#9E9E9E" FontFamily="Consolas" FontSize="11"
                                 TextWrapping="Wrap" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        <TextBlock Grid.Row="1" x:Name="TxtMeta" Text="" Foreground="#555555"
                                   FontSize="11" Margin="0,8,0,0" FontFamily="Consolas"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
